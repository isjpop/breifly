# Copy to .env and adjust. Never commit .env.

# --- Application ---
APP_ENV=development            # development | test | production
LOG_LEVEL=INFO

# --- Database ---
# Docker Compose builds DATABASE_URL from these:
POSTGRES_USER=briefly
POSTGRES_PASSWORD=briefly
POSTGRES_DB=briefly
# For running the backend outside Docker:
DATABASE_URL=postgresql+psycopg://briefly:briefly@localhost:5432/briefly
TEST_DATABASE_URL=postgresql+psycopg://briefly:briefly@localhost:5432/briefly_test
DATABASE_POOL_SIZE=5
DATABASE_ECHO=false

# --- Frontend (Vite) ---
# Where the Vite dev server forwards /api requests.
VITE_API_PROXY_TARGET=http://localhost:8000

# --- Production compose ---
WEB_PORT=80
