# Copy to .env and adjust. Never commit .env.

# --- Application ---
APP_ENV=development            # development | test | production
LOG_LEVEL=INFO

# --- Database ---
# Docker Compose builds DATABASE_URL from these:
POSTGRES_USER=briefly
POSTGRES_PASSWORD=briefly
POSTGRES_DB=briefly
# For running the backend outside Docker:
DATABASE_URL=postgresql+psycopg://briefly:briefly@localhost:5432/briefly
TEST_DATABASE_URL=postgresql+psycopg://briefly:briefly@localhost:5432/briefly_test
DATABASE_POOL_SIZE=5
DATABASE_ECHO=false

# --- Ingestion ---
INGESTION_INTERVAL_MINUTES=15
INGESTION_USER_AGENT="BrieflyBot/0.1 (+news aggregator; RSS reader)"
HTTP_TIMEOUT_SECONDS=15
HTTP_MAX_RETRIES=3
HTTP_BACKOFF_BASE_SECONDS=1
HTTP_BACKOFF_MAX_SECONDS=30
FEED_MAX_BYTES=5000000
FEED_MAX_ENTRIES=100
DEDUP_LOOKBACK_HOURS=72

# --- AI summarization (Gemini) ---
# Get a key at https://aistudio.google.com/apikey. Leave empty to run without AI: articles are
# still ingested, categorized (rules) and ranked; summaries wait until a key is set.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
LLM_REQUESTS_PER_MINUTE=10        # stay at or under your plan's limit
LLM_MAX_SUMMARIES_PER_RUN=40      # cap per 15-minute tick
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=2
SUMMARY_MAX_ATTEMPTS=3
# Paid list price per 1M tokens, used for cost *estimates* (free tier actual cost is $0)
LLM_INPUT_COST_PER_MILLION=0.30
LLM_OUTPUT_COST_PER_MILLION=2.50

# --- Importance ranking (weights must sum to 1) ---
RANKING_WEIGHT_IMPACT=0.35
RANKING_WEIGHT_SIGNIFICANCE=0.30
RANKING_WEIGHT_CREDIBILITY=0.20
RANKING_WEIGHT_RECENCY=0.15
RANKING_RECENCY_HALF_LIFE_HOURS=12

# --- Frontend (Vite) ---
# Where the Vite dev server forwards /api requests.
VITE_API_PROXY_TARGET=http://localhost:8000

# --- Production compose ---
WEB_PORT=80
